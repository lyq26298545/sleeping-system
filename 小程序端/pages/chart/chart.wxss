page { background: #f7f9fc; }
.container { padding: 30rpx; height: 100vh; box-sizing: border-box; }

.header { margin-bottom: 40rpx; }
.title { font-size: 44rpx; font-weight: bold; color: #333; display: block; }
.subtitle { font-size: 26rpx; color: #999; margin-top: 10rpx; }

.chart-box {
  width: 100%;
  height: 700rpx; /* 固定高度 */
  background: #fff;
  border-radius: 30rpx;
  padding: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05);
}

ec-canvas { width: 100%; height: 100%; }

.empty-holder {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding-top: 200rpx;
}
.empty-holder image { width: 300rpx; height: 300rpx; margin-bottom: 40rpx; }
.empty-holder text { color: #999; font-size: 28rpx; }

.go-btn {
  margin-top: 40rpx; background: #1890ff; color: #fff; 
  border-radius: 50rpx; width: 300rpx;
}

.tip-bar {
  text-align: center; font-size: 24rpx; color: #bbb; margin-top: 30rpx;
}