.container{
  padding: 30rpx;
  background: #f5f7fa;
  min-height: 100vh;
}
.title{
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 60rpx;
  color: #2c3e50;
}
.form-item{
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}
.label{
  font-size: 32rpx;
  color: #333;
  margin-bottom: 15rpx;
}
input{
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 30rpx;
}
.btn{
  margin-top: 40rpx;
  background: #409eff;
  color: #fff;
}
.result-card{
  margin-top: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}
.res-title{
  font-size: 40rpx;
  font-weight: bold;
  color: #e63946;
  margin-bottom: 20rpx;
}
.res-level{
  font-size: 36rpx;
  color: #1d4ed8;
  margin-bottom: 20rpx;
}
.res-tip{
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
.disclaimer{
  margin-top: 60rpx;
  font-size: 22rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}