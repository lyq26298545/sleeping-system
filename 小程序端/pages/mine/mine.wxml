<view class="user-card">
  <view class="avatar-wrap" bindtap="chooseAvatar">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
    <view class="edit-avatar">✏️</view>
  </view>
  
  <view class="user-info" bindtap="editUserInfo">
    <view class="user-name">{{userName || '新用户'}}</view>
    <view class="user-desc">{{userDesc}}</view>
  </view>
</view>