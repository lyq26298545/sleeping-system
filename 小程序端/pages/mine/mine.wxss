page{
  background: #f0f4f8;
}
.container{
  padding: 0;
  min-height: 100vh;
  position: relative;
}
/* 背景图（预留路径，你替换 /images/mine-bg.png 即可） */
.bg-img{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 320rpx;
  z-index: 1;
  opacity: 0.9;
}
/* 个人信息卡片 */
.user-card{
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  gap: 24rpx;
}
/* 头像区（预留点击编辑） */
.avatar-wrap{
  position: relative;
}
.avatar{
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
}
.edit-avatar{
  position: absolute;
  bottom: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #1890ff;
  color: #fff;
  border-radius: 50%;
  font-size: 20rpx;
}
/* 个人信息文字 */
.user-info{
  flex: 1;
}
.user-name{
  font-size: 40rpx;
  font-weight: 600;
  color: #1d2939;
  margin-bottom: 8rpx;
}
.user-desc{
  font-size: 26rpx;
  color: #667085;
}
/* 功能跳转区 */
.func-wrap{
  position: relative;
  z-index: 2;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
}
.func-item{
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 36rpx 30rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 30, 80, 0.05);
  gap: 20rpx;
}
.func-icon{
  font-size: 36rpx;
  width: 60rpx;
  text-align: center;
}
.func-text{
  flex: 1;
  font-size: 34rpx;
  color: #1d2939;
  font-weight: 500;
}
.func-arrow{
  font-size: 28rpx;
  color: #98a2b3;
}
/* 免责声明 */
.disclaimer{
  position: relative;
  z-index: 2;
  margin: 0 30rpx 60rpx;
  font-size: 22rpx;
  color: #98a2b3;
  text-align: center;
  line-height: 1.6;
}